# Add a key for the provider you want, or paste one into the app's "ai provider" screen.
# With no key at all, Athena uses local Ollama.
OPENAI_API_KEY=sk-your-api-key-here
# ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Which provider answers: openai, anthropic or ollama. Optional: by default the first
# of OpenAI / Anthropic that has a key is used, otherwise Ollama.
# LLM_PROVIDER=openai

# Optional model overrides
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-haiku-5-5
# OLLAMA_MODEL=llama3.1:8b
